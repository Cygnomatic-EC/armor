build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D E:\Download\RM\armor\build\Debug && D:\STM32\CLT\STM32CubeCLT_1.20.0\CMake\bin\cmake.exe --regenerate-during-build -SE:\Download\RM\armor -BE:\Download\RM\armor\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Write statements declared in CMakeLists.txt:
# E:/Download/RM/armor/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for OBJECT_LIBRARY target STM32_Drivers


